# Depuis la racine : python3 workflow/init-local-env.py
# Les valeurs réelles restent dans .env, exclu de Git.
SAM_DATA_SOURCE=mock
DIGIMON_BASE_URL=
DIGIMON_TIMEOUT=10
POSTGRES_PASSWORD=
SAM_DEMO_PASSWORD=

# Interface Dash locale
DASH_PORT=8050
DASH_COOKIE_SECURE=false
DEMO_ACCOUNTS_ENABLED=true

# Calendrier administratif commun (identifiant IANA)
BUSINESS_TIMEZONE=Europe/Paris

# Outils de rejeu du lac fictif, réservés aux démonstrations contrôlées
DEMO_TOOLS_ENABLED=false

# Activer seulement après import validé de la génération existante
COLLECTION_ENABLED=false
COLLECTION_SOURCE=digimon
COLLECTION_SCOPE=group
# Garde-fou de baisse de couverture, fraction comprise entre 0 exclu et 1
COLLECTION_MINIMUM_RETAINED_FRACTION=0.9
